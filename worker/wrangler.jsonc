{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "backrow",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "backrow.n3el.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/ws/*", "/p/*", "/watch/*", "/host"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Quota"] },
    { "tag": "v2", "deleted_classes": ["Quota"] }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "backrow-accounts", "database_id": "cdfff057-076e-400f-8074-86906ae0fb45", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "4202", "simple": { "limit": 20, "period": 60 } }
  ]
}
